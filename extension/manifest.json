{
  "manifest_version": 3,
  "name": "DeepFocus Guard",
  "description": "DeepFocus website supervision bridge",
  "version": "0.2.0",
  "key": "",
  "permissions": [
    "webNavigation",
    "tabs",
    "storage",
    "nativeMessaging",
    "alarms"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "DeepFocus Guard"
  },
  "web_accessible_resources": [
    {
      "resources": ["block.html", "block.js", "block.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
